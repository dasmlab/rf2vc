# Stage 1: Build Go binary
FROM docker.io/library/golang:1.23-bookworm AS go-builder
WORKDIR /app
ARG ARCH=amd64
ARG BUILD_VERSION=dev
ENV GOPROXY=https://proxy.golang.org

COPY go.mod go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY web/ ./web/

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${ARCH} \
    go build -ldflags "-s -w -X main.buildVersion=${BUILD_VERSION}" \
    -o /rf2vc ./cmd/gateway

# Stage 2: Runtime
FROM docker.io/library/debian:bookworm-slim

ARG BUILD_VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/dasmlab/rf2vc" \
      org.opencontainers.image.url="https://github.com/dasmlab/rf2vc" \
      org.opencontainers.image.title="rf2vc" \
      org.opencontainers.image.description="Redfish BMC facade over vSphere for ACM/MCE BareMetalHost" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.vendor="dasmlab" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -u 65532 -r -s /usr/sbin/nologin appuser \
    && mkdir -p /data/iso-cache /etc/rf2vc \
    && chown -R 65532:65532 /data

# Baked default for smoke/local; cluster ConfigMap overlays /etc/rf2vc.
COPY configs/gateway.smoke.yaml /etc/rf2vc/gateway.yaml

USER 65532

WORKDIR /app
COPY --from=go-builder /rf2vc /app/rf2vc

ENV RF2VC_LISTEN=:8080
ENV RF2VC_DATA_DIR=/data
EXPOSE 8080

ENTRYPOINT ["/app/rf2vc"]
CMD ["-config", "/etc/rf2vc/gateway.yaml"]
